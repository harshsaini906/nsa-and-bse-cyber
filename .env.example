# TradingAI - Environment Configuration Example
# Copy this file to `.env` and fill in your values.
# NEVER commit your actual `.env` file containing secrets to GitHub or version control.

# ── APPLICATION & SERVER ──
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# ── NIFTY & SENSEX 1H BREAKOUT STRATEGY ──
STRATEGY_TARGET_POINTS=50.0
STRATEGY_STOP_LOSS_POINTS=20.0
STRATEGY_ONE_TRADE_PER_CANDLE=true
STRATEGY_ALLOW_REENTRY_SAME_CANDLE=false
STRATEGY_CARRY_OVERNIGHT_REFERENCE=false
STRATEGY_SLIPPAGE_POINTS=1.0

# ── POSITION SIZING & RISK ──
NIFTY_LOT_SIZE=25
NIFTY_LOTS_PER_TRADE=2
SENSEX_LOT_SIZE=10
SENSEX_LOTS_PER_TRADE=2
INITIAL_CAPITAL=200000.0
BROKERAGE_PER_ORDER=20.0

# ── EXECUTION & FALLBACK MODE ──
# Set to true only after broker credentials are configured and live trading is approved
LIVE_TRADING_ENABLED=false
USE_MOCK_DATA_FALLBACK=true
SCAN_INTERVAL_SECONDS=5

# ── OPTIONAL NOTIFICATION ALERTS ──
# Telegram Bot Alerts
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Discord / Slack Webhook Alerts
WEBHOOK_ALERTS_ENABLED=false
WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here
